# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/teeco_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/teeco_test
# Public base URL of the app (used in links sent by SMS/email)
APP_URL=http://localhost:3000
# 32+ random characters; signs session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Database used by Playwright end-to-end tests (recreated on each run)
E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/teeco_e2e
