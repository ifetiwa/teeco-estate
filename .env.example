# Copy to .env and fill in. Never commit .env.
# The app connects as a restricted role (no RLS bypass); migrations run as the owner and create/grant that role.
DATABASE_URL=postgresql://teeco_app:change-me@127.0.0.1:5432/teeco_dev
DATABASE_OWNER_URL=postgresql://postgres:postgres@127.0.0.1:5432/teeco_dev
TEST_DATABASE_URL=postgresql://teeco_app:change-me@127.0.0.1:5432/teeco_test
TEST_DATABASE_OWNER_URL=postgresql://postgres:postgres@127.0.0.1:5432/teeco_test
# Public base URL of the app (used in links sent by SMS/email)
APP_URL=http://localhost:3000
# 32+ random characters; signs session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# SMS: unset = codes are only logged (development). For real SMS use Termii (https://termii.com):
# SMS_PROVIDER=termii
# TERMII_API_KEY=            (Termii dashboard > API settings)
# TERMII_SENDER_ID=MyEstate  (must be approved by Termii first)
# TERMII_CHANNEL=dnd         (dnd reaches Do-Not-Disturb numbers; needed for sign-in codes)
# TERMII_BASE_URL=https://api.ng.termii.com   (use the base URL shown on your Termii dashboard)
# Push notifications (Firebase Cloud Messaging): the service account JSON, on one line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Optional, testing only: fixed sign-in codes for named phones while no SMS provider is connected.
# Set in the host's secret settings, never commit real values, and remove before real residents use the app.
# TEST_LOGIN_CODES=08031234567:482915
# Database used by Playwright end-to-end tests (recreated on each run)
E2E_DATABASE_URL=postgresql://teeco_app:change-me@127.0.0.1:5432/teeco_e2e
E2E_DATABASE_OWNER_URL=postgresql://postgres:postgres@127.0.0.1:5432/teeco_e2e
