{
  "appId": "ng.teeco.estate",
  "appName": "MyEstateapp",
  "webDir": "www",
  "server": {
    "url": "https://teeco-estate.vercel.app/app",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0f5132"
  },
  "appendUserAgent": "MyEstateappAndroid",
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
